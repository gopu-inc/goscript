golem legacy_http

pub fn Get(url: string): string { ret gs_http_get(url) }
pub fn GetWithHeaders(url: string, headers: string): string { ret gs_http_get_headers(url, headers) }
pub fn GetJSON(url: string): string { ret gs_http_get(url) }
pub fn GetTimeout(url: string, timeout: int): string { ret gs_http_get_timeout(url, timeout) }
pub fn Post(url: string, data: string): string { ret gs_http_post(url, data) }
pub fn PostFile(url: string, file_path: string): string { ret gs_http_post_file(url, file_path) }
pub fn PostAuth(url: string, data: string, username: string, password: string): string {
    ret gs_http_post_auth(url, data, username, password)
}
